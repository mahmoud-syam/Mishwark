{
  "name": "acswebsite",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "tsc && node postbuild.js",
    "start": "node dist/src/index.js",
    "dev": "nodemon --watch src --ext ts --exec ts-node src/index.ts",
    "prisma:generate": "npx prisma generate",
    "api-docs:build": "node build-api-docs.js",
    "api-docs:check": "node check-api-docs.js",
    "api-docs": "npm run api-docs:build && npm run api-docs:check",
    "smoke": "npx tsx scripts/smoke-test.ts",
    "smoke:coverage": "npx tsx scripts/check-smoke-coverage.ts",
    "test": "npx tsx tests/infra/run-all.ts",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run api-docs:check && npm test && npm run smoke",
    "seed": "npx tsx prisma/seed/seed.ts",
    "seed:api": "npx tsx prisma/seed/api_seed_roles.ts",
    "seed:demo": "npx tsx prisma/seed/demo.ts",
    "dashboard:dev": "npm --prefix dashboard run dev",
    "dashboard:build": "npm --prefix dashboard ci && npm --prefix dashboard run build"
  },
  "prisma": {
    "seed": "tsx prisma/seed/seed.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@prisma/adapter-pg": "^7.4.2",
    "@prisma/client": "^7.8.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.12.0",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.10",
    "otplib": "^13.4.1",
    "postmanify-express": "^2.2.1",
    "prisma": "^7.8.0",
    "qrcode": "^1.5.4",
    "swagger-ui-express": "^5.0.1",
    "uuidv4": "^6.2.13",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.19.39",
    "@types/qrcode": "^1.5.6",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "zod-prisma-types": "^3.3.11"
  }
}
