{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@prisma/client": ["./generated/prisma"]
    },
    "module": "commonjs",
    "esModuleInterop": true,
    "target": "es6",
    "moduleResolution": "node",
    "sourceMap": true,
    "outDir": "dist",
    "skipLibCheck": true,
    "strict": false,
    "resolveJsonModule": true
  },
  "lib": ["es2015"],
  "include": ["src/**/*", "prisma/seed/**/*", "src/v1/types/**/*.d.ts"],
  "exclude": ["node_modules", "src/v1/schemas/zod"]
}