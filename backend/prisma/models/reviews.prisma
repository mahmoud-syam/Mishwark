model Reviews {
  id                String       @id @default(uuid())
  booking           Bookings     @relation(fields: [bookingId], references: [id])
  bookingId         String
  reviewer          Users        @relation("ReviewsGiven", fields: [reviewerId], references: [id])
  reviewerId        String
  reviewee          Users        @relation("ReviewsReceived", fields: [revieweeId], references: [id])
  revieweeId        String
  reviewerType      ReviewerType
  overallRating     Int
  vehicleRating     Int?
  punctualityRating Int?
  comment           String?
  visibleAt         DateTime?
  // A complaint the office has dealt with (who, when, what was done).
  handledAt         DateTime?
  handledBy         Users?       @relation("ReviewsHandled", fields: [handledById], references: [id])
  handledById       String?
  handlingNote      String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @default(now()) @updatedAt

  @@index([reviewerType, overallRating, handledAt])
  @@index([createdAt])
}
