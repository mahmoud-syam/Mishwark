model Users {
  id                String  @id @default(uuid())
  code              String  @default("")
  name              String
  email             String? @unique
  pic               String  @default("")
  password          String  @default("")
  preferredLanguage String  @default("ar")

  isDeleted        Boolean @default(false)
  twoFactorEnabled Boolean @default(false)
  twoFactorSecret  String? @default("")
  tokenVersion     Int     @default(0)

  phoneNumber  String? @unique
  otpVerified  Boolean @default(false)
  otpCode      String?
  otpExpiresAt DateTime?
  otpAttempts  Int     @default(0)
  otpSentAt    DateTime?
  referralCode String? @unique
  referredById String?
  referredBy   Users?  @relation("Referrals", fields: [referredById], references: [id])
  referrals    Users[] @relation("Referrals")

  phoneNumbers   PhoneNumbers[]
  customerRating Float?         @default(5.0)
  role           Role           @relation("UserRoles", fields: [roleId], references: [id], onDelete: Restrict)
  roleId         String

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  drivers                Drivers?
  bookings               Bookings[]
  packages               Packages[]
  payments               Payments[]
  reviewsGiven           Reviews[]                @relation("ReviewsGiven")
  reviewsReceived        Reviews[]                @relation("ReviewsReceived")
  waitlists              Waitlist[]
  customerConversations  Conversations[]          @relation("CustomerConversations")
  sentMessages           Messages[]
  scheduledNotifications ScheduledNotifications[] @relation("NotificationRecipient")
  referralsGiven         Referrals[]              @relation("Referrer")
  referralsReceived      Referrals[]              @relation("Referred")
  walletTransactions     WalletTransactions[]
  auditLogs              AuditLogs[]
}

model PhoneNumbers {
  id     String @id @default(uuid())
  number String

  user      Users?   @relation(fields: [userId], references: [id])
  userId    String?
  drivers   Drivers? @relation(fields: [driversId], references: [id])
  driversId String?
}

model Drivers {
  id            String         @id @default(uuid())
  user          Users          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String         @unique
  fullName      String         @default("")
  phoneNumbers  PhoneNumbers[]
  licenseNumber String         @default("")
  licenseExpiry DateTime?
  pic           String         @default("")
  rating        Float?         @default(5.0)
  status        DriverStatus   @default(ACTIVE)
  // Company share of each completed trip, in percent (0-100).
  commissionRate Float         @default(20)
  // True when an admin set the current OFF/ONLEAVE status; the driver app
  // can't override it until an admin reactivates the driver.
  statusSetByAdmin Boolean     @default(false)

  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @default(now()) @updatedAt
  vehicleDrivers      VehicleDrivers[]
  bookings            Bookings[]
  driverConversations Conversations[] @relation("DriverConversations")
}
