model Vehicles {
  id                    String                @id @default(uuid())
  make                  String                @default("")
  model                 String                @default("")
  year                  Int                   @default(2024)
  plateNumber           String                @unique @default("")
  color                 String                @default("")
  capacity              Int                   @default(0)
  category              VehicleCategory       @default(CAR)
  status                VehicleStatus         @default(AVAILABLE)
  basePrice             Float                 @default(0)
  pricePerKm            Float                 @default(0)
  pricePerHour          Float                 @default(0)
  /// Fixed wedding price for this car; null = the default in Settings.
  weddingPrice          Float?
  /// Fixed VIP-occasion price for this car; null = the default in Settings.
  vipPrice              Float?
  images                VehicleImages[]
  description           String                @default("")
  /// Bags the car takes (shown on the car screen in the customer app).
  luggage               Int                   @default(0)
  /// Feature tags for the app ("تكييف", "واي فاي"...).
  features              String[]              @default([])
  /// Set when the car is taken out of service. Retired cars are hidden from the
  /// app and from new bookings; their history stays.
  retiredAt             DateTime?
  retiredReason         String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @default(now()) @updatedAt
  vehicleDrivers        VehicleDrivers[]
  vehicleAvailabilities VehicleAvailability[]
  bookings              Bookings[]
  waitlists             Waitlist[]
  maintenance           VehicleMaintenance[]
}

model VehicleImages {
  id        String   @id @default(uuid())
  vehicle   Vehicles @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  vehicleId String
  imageUrl  String   @default("")
  isCover   Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model VehicleDrivers {
  id        String   @id @default(uuid())
  vehicle   Vehicles @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  vehicleId String
  driver    Drivers  @relation(fields: [driverId], references: [id], onDelete: Cascade)
  driverId  String
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model VehicleAvailability {
  id        String             @id @default(uuid())
  vehicle   Vehicles           @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  vehicleId String
  date      DateTime
  status    AvailabilityStatus @default(AVAILABLE)
  reason    String             @default("")
  booking   Bookings?          @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  bookingId String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @default(now()) @updatedAt

  @@unique([vehicleId, date])
}

model VehicleMaintenance {
  id              String    @id @default(uuid())
  vehicle         Vehicles  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  vehicleId       String
  maintenanceType String
  cost            Float     @default(0)
  /// First and last day of the maintenance (both inclusive). The car can't be
  /// booked on those days.
  scheduledDate   DateTime
  endDate         DateTime?
  completedDate   DateTime?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt

  @@index([vehicleId, scheduledDate])
}
