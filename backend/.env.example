# Local DB from the root docker-compose.yml:
# DATABASE_URL=postgresql://admin:pass@localhost:5433/mishwarak
DATABASE_URL=
PORT=
JWT_SECRET=

# OpenRouteService. Get a free key at https://openrouteservice.org/dev/#/signup
# Leave blank in development: the backend then falls back to a straight-line
# haversine estimate instead of real road routing.
ORS_API_KEY=
ORS_BASE_URL=https://api.openrouteservice.org
ORS_TIMEOUT_MS=5000

# Time zone used for "today", month boundaries and trip delay math. Bookings
# store local dates/times, so this must match where the business operates.
BUSINESS_TZ=Africa/Cairo

# Where the built admin dashboard lives (frontend/dist by default, relative to
# backend/). Set it when the build is deployed somewhere else.
DASHBOARD_DIST=
# Extra allowed CORS origins, comma-separated (the built dashboard is served by
# this API at /dashboard and doesn't need one).
CORS_ORIGINS=

# Auth cookie (web dashboard). Secure (HTTPS-only) is on when NODE_ENV=production.
# Set COOKIE_SECURE=false only for a staging server without HTTPS.
COOKIE_SECURE=
# SMS for OTP codes. Leave SMS_PROVIDER empty in local dev: the code is then
# returned to the app as dev_otp. Once set, codes are only sent by SMS.
#   twilio -> TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_FROM
#   http   -> SMS_HTTP_URL (+ SMS_HTTP_TOKEN, SMS_SENDER): POST {to, message, sender}
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
SMS_HTTP_URL=
SMS_HTTP_TOKEN=
SMS_SENDER=Mishwark
# OTP policy
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60
# "0000" test code; always off in production unless explicitly enabled
OTP_TEST_BYPASS=false

# Booking rules (deposit %, gap between trips, early start, prices...) are
# edited on the dashboard Settings page and stored in the database.

# Sign-in protection. Requests per IP per 15 minutes on /auth (and on OTP
# requests, which send SMS). Wrong passwords/codes are limited separately:
# 5 per device and account, then that device is blocked for 15 minutes.
AUTH_RATE_LIMIT=100
OTP_REQUEST_RATE_LIMIT=10
# Behind a proxy, how to read the visitor's IP. "loopback" fits Cloudflare
# Tunnel (cloudflared on the same machine). Behind one other proxy use 1.
TRUST_PROXY=loopback
# How long customers and drivers stay signed in on the apps (OTP sign-in), in
# days. Dashboard accounts always get 24 hours.
APP_SESSION_DAYS=30
# Booking map (OpenStreetMap). Defaults are the public servers; point these at
# self-hosted Photon / Nominatim if traffic grows. Requests per IP per 15 min.
# PHOTON_URL=https://photon.komoot.io
# NOMINATIM_URL=https://nominatim.openstreetmap.org
PLACES_RATE_LIMIT=300
# Private folder for drivers' papers (ID, licence, criminal record). Never under
# a public folder; keep it on a persistent volume and in your backups.
DRIVER_DOCUMENTS_DIR=storage/driver-documents
