// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

// Emits Zod schemas mirroring the models into src/v1/schemas/zod. Test suites
// import from there, so `npx prisma generate` must produce both.
generator zod {
  provider    = "zod-prisma-types"
  output      = "../src/v1/schemas/zod"
  isGenerateObservable = false
}

datasource db {
  provider = "postgresql"
}
