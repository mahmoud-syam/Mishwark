model Bookings {
  id             String    @id @default(uuid())
  customer       Users     @relation(fields: [customerId], references: [id])
  customerId     String
  vehicle        Vehicles  @relation(fields: [vehicleId], references: [id])
  vehicleId      String
  driver         Drivers   @relation(fields: [driverId], references: [id])
  driverId       String
  package        Packages? @relation(fields: [packageId], references: [id], onDelete: SetNull)
  packageId      String?
  eventType      String    @default("")
  startPoint     String    @default("")
  endPoint       String    @default("")
  routeWaypoints Json?
  distanceKm     Float     @default(0)

  // Server-computed routing result. distanceKm above is kept as the canonical
  // figure used for pricing; durationMinutes has no column of its own
  // historically, so it was accepted, priced with, and then discarded.
  durationMinutes Float    @default(0)
  // Resolved coordinates for the two endpoints. Populated when the client sends
  // lat/lng, or when the server geocodes the free-text startPoint/endPoint.
  startLat        Float?
  startLng        Float?
  endLat          Float?
  endLng          Float?
  // "openrouteservice" | "haversine" | "client" - how distanceKm was obtained.
  distanceSource   String    @default("")
  // What the client claimed, kept purely for auditing mismatches against the
  // server-computed value. Never used for pricing.
  claimedDistanceKm Float?
  claimedDurationMinutes Float?

  bookingDate    String    @default("")
  startTime      String    @default("")
  endTime        String    @default("")

  status                 BookingStatus            @default(PENDING)
  tripStatus             TripStatus               @default(NOTSTARTED)
  // Wall-clock times the driver actually started/finished the trip. Drive the
  // admin live-operations view (elapsed, remaining, delay).
  tripStartedAt          DateTime?
  tripCompletedAt        DateTime?
  basePrice              Float                    @default(0)
  distancePrice          Float                    @default(0)
  totalPrice             Float                    @default(0)
  // Deposit the customer must pay to confirm (a % of totalPrice), and what has
  // actually been paid so far (sum of SUCCESS payments). They used to be one
  // field, which recorded the deposit as paid the moment the booking existed.
  depositRequired        Float                    @default(0)
  depositPaid            Float                    @default(0)
  paymentStatus          PaymentStatus            @default(UNPAID)
  driverNotes            String                   @default("")
  notes                  String                   @default("")
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @default(now()) @updatedAt

  payments               Payments[]
  reviews                Reviews[]
  conversation           Conversations?
  waitlists              Waitlist[]
  scheduledNotifications ScheduledNotifications[]
  referrals              Referrals[]
  vehicleAvailabilities  VehicleAvailability[]
  tripLocations          TripLocations[]

  @@unique([vehicleId, bookingDate, startTime])
}

model TripLocations {
  id         String   @id @default(uuid())
  booking    Bookings @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId  String
  latitude   Float
  longitude  Float
  speed      Float?
  recordedAt DateTime @default(now())
}
