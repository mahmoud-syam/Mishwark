# Production settings for deploy/docker-compose.yml. setup.sh copies this to
# deploy/.env and fills the generated secrets; edit the rest there. Never commit
# deploy/.env (it is git-ignored).

# --- Generated by setup.sh -----------------------------------------------------
# Database password (hex only, it goes into a URL).
POSTGRES_PASSWORD=
# Signs sign-in tokens; at least 32 characters. Changing it signs everyone out.
JWT_SECRET=

# --- Cloudflare Tunnel ---------------------------------------------------------
# Zero Trust > Networks > Tunnels > your tunnel > the token (starts with eyJ).
# Its public hostname (e.g. mishwark.mahmoud-syam.me) must point to http://api:5000
TUNNEL_TOKEN=

# --- Public address ------------------------------------------------------------
# The dashboard is served from the same address, so this is only for other web
# origins that call the API from a browser (comma-separated). Usually empty.
CORS_ORIGINS=
COOKIE_SECURE=true

# --- SMS for sign-in codes -------------------------------------------------------
# Until a provider is set, customers and drivers can't sign in with a code on
# this server (the API answers 503), unless OTP_DEV_RESPONSE=true, which returns
# the code in the response: only while the app is in closed testing.
#   twilio -> TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_FROM
#   http   -> SMS_HTTP_URL (+ SMS_HTTP_TOKEN, SMS_SENDER)
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
SMS_HTTP_URL=
SMS_HTTP_TOKEN=
SMS_SENDER=Mishwark
OTP_DEV_RESPONSE=false
OTP_TEST_BYPASS=false

# --- Optional services ----------------------------------------------------------
# Road distances (openrouteservice.org). Empty: straight-line estimates.
ORS_API_KEY=
# Push notifications: put the Firebase service-account file in deploy/secrets/
# as firebase.json, then uncomment:
# FCM_SERVICE_ACCOUNT_FILE=/run/mishwark/firebase.json

# --- Backups ----------------------------------------------------------------------
# Daily at this hour (UTC; 01 = 3 a.m. Cairo), kept this many days in deploy/backups.
BACKUP_HOUR_UTC=01
BACKUP_KEEP_DAYS=14
# Off-server copy to Cloudflare R2 (recommended). Create a bucket and an R2 API
# token with write access to it. Copies are encrypted with BACKUP_PASSPHRASE:
# keep that passphrase somewhere safe outside the server, or the copies can't
# be opened.
BACKUP_PASSPHRASE=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
